datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  email             String   @unique
  passwordHash      String
  role              String   @default("EMPLOYEE") // ADMIN or EMPLOYEE
  firstName         String
  lastName          String
  phone             String?  @default("")
  address           String?  @default("")
  profilePictureUrl String?  @default("")
  jobTitle          String?  @default("Software Engineer")
  department        String?  @default("Engineering")
  joiningDate       String?  @default("2025-01-01")
  baseSalary        Float    @default(50000.0)

  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  payrolls          Payroll[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Attendance {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String   // YYYY-MM-DD
  checkIn    DateTime?
  checkOut   DateTime?
  totalHours Float?   @default(0)
  status     String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LeaveRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType     String   // PAID, SICK, UNPAID
  startDate     String   // YYYY-MM-DD
  endDate       String   // YYYY-MM-DD
  totalDays     Float    @default(1.0)
  remarks       String?  @default("")
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminComments String?  @default("")
  reviewedBy    String?  @default("")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payroll {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthYear     String   // e.g., 2026-08
  basicSalary   Float
  allowances    Float    @default(0)
  deductions    Float    @default(0)
  netSalary     Float
  paymentStatus String   @default("PAID") // PAID, PENDING

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
